// Apple Store Inventory System — database schema
// PostgreSQL + Prisma. All money is in one currency (USD), Decimal(12, 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum LocationType {
  WAREHOUSE
  SHOP
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  IN_TRANSIT
  AT_PARTNER
  DEBT // sold, money not fully collected
  SOLD // fully paid
  RETURNED
  DEFECTIVE
}

enum ItemCondition {
  NEW
  USED
  REFURBISHED
}

enum IdentifierType {
  IMEI
  SERIAL
  SYSTEM_CODE // our own printed label
}

enum ShareType {
  NONE // investor gets all profit
  PERCENT // investor gets shareValue % of profit
  FIXED_PER_ITEM // business keeps shareValue per item, investor gets the rest
}

enum CostSplitMethod {
  NONE // extra costs not added to items (default)
  EQUAL
  BY_PRICE
}

enum PaymentMethod {
  CASH
  CARD
}

enum SaleStatus {
  DEBT // not fully paid
  PAID
  RETURNED
}

enum ConsignmentItemStatus {
  AT_PARTNER
  SOLD_UNPAID
  SOLD_PAID
  RETURNED
}

enum InvestorTxType {
  DEPOSIT // money put in
  PAYOUT // money paid back
}

enum LedgerType {
  INCOME // Prixod
  EXPENSE // Rasxod
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
}

enum ReturnResult {
  BACK_TO_STOCK
  DEFECTIVE
}

// ─────────────────────────────────────────────
// Users and permissions (#26, #27)
// ─────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // "Admin", "Staff", later "Investor"
  permissions String[] // e.g. ["sell", "transfer_stock", "view_profit"]
  users       User[]
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  investorId   Int?      @unique // set only for investor logins (Phase 2)
  investor     Investor? @relation(fields: [investorId], references: [id])
  createdAt    DateTime  @default(now())

  auditLogs AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String // "create" | "update" | "delete" | "mark_sold" ...
  entity    String // "Item", "Sale", "ConsignmentItem" ...
  entityId  Int
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Locations and investors (#1, #9, #10)
// ─────────────────────────────────────────────

model Location {
  id    Int          @id @default(autoincrement())
  name  String       @unique // "Sklad", "Dokon"
  type  LocationType
  items Item[]
}

model Investor {
  id         Int       @id @default(autoincrement())
  name       String // "Own", "Sardor", "Roshan"
  code       String    @unique // "OWN", "S", "R"
  isOwn      Boolean   @default(false) // true = the business itself
  shareType  ShareType @default(NONE)
  shareValue Decimal   @default(0) @db.Decimal(12, 2)

  items        Item[]
  batches      Batch[]
  transactions InvestorTransaction[]
  user         User?
}

model InvestorTransaction {
  id         Int            @id @default(autoincrement())
  investorId Int
  investor   Investor       @relation(fields: [investorId], references: [id])
  type       InvestorTxType
  amount     Decimal        @db.Decimal(12, 2)
  date       DateTime       @default(now())
  note       String?
}

// ─────────────────────────────────────────────
// Catalog (#2, #4, #7)
// ─────────────────────────────────────────────

model Category {
  id           Int                 @id @default(autoincrement())
  name         String              @unique // "iPhone", "MacBook", "Accessory"
  isSerialized Boolean             @default(true) // false = counted by quantity
  attributes   CategoryAttribute[]
  models       ProductModel[]
}

// Defines the dynamic fields for a category, e.g. MacBook → "processor", "ram"
model CategoryAttribute {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   Category      @relation(fields: [categoryId], references: [id])
  key        String // "processor"
  label      String // "Processor"
  type       AttributeType @default(TEXT)
  options    String[] // for SELECT, e.g. ["M2", "M4", "M5"]
  required   Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@unique([categoryId, key])
}

model ProductModel {
  id                Int      @id @default(autoincrement())
  categoryId        Int
  category          Category @relation(fields: [categoryId], references: [id])
  name              String // "iPhone 15 Pro", "MacBook Air 13 M4", "USB-C charger"
  lowStockThreshold Int? // alert when stock drops below this (#7)

  items     Item[]
  stock     AccessoryStock[]
  saleItems SaleItem[]

  @@unique([categoryId, name])
}

// Quantity-based stock for non-serialized products (#4)
model AccessoryStock {
  id             Int          @id @default(autoincrement())
  productModelId Int
  productModel   ProductModel @relation(fields: [productModelId], references: [id])
  locationId     Int
  quantity       Int          @default(0)
  avgCost        Decimal      @default(0) @db.Decimal(12, 2)

  @@unique([productModelId, locationId])
}

// ─────────────────────────────────────────────
// Items — one row per physical device (#1, #3, #5, #11, #13, #21)
// ─────────────────────────────────────────────

model Item {
  id             Int           @id @default(autoincrement())
  productModelId Int
  productModel   ProductModel  @relation(fields: [productModelId], references: [id])
  investorId     Int
  investor       Investor      @relation(fields: [investorId], references: [id])
  locationId     Int
  location       Location      @relation(fields: [locationId], references: [id])
  status         ItemStatus    @default(IN_STOCK)
  condition      ItemCondition @default(NEW)
  attributes     Json // values for CategoryAttribute keys, e.g. {"ram": "16GB"}

  purchasePrice Decimal  @db.Decimal(12, 2)
  extraCost     Decimal  @default(0) @db.Decimal(12, 2) // share of batch extra costs (#16)
  salePrice     Decimal? @db.Decimal(12, 2) // planned selling price
  minSalePrice  Decimal? @db.Decimal(12, 2) // staff can't sell below this

  // where it came from: a supplier batch OR a walk-in seller
  batchId        Int?
  batch          Batch?        @relation(fields: [batchId], references: [id])
  walkInSellerId Int?
  walkInSeller   WalkInSeller? @relation(fields: [walkInSellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifiers      ItemIdentifier[]
  transferItems    TransferItem[]
  saleItems        SaleItem[]
  consignmentItems ConsignmentItem[]

  @@index([status])
  @@index([investorId])
  @@index([locationId])
}

// IMEI 1, IMEI 2, serial and system code — each value unique across ALL items
model ItemIdentifier {
  id     Int            @id @default(autoincrement())
  itemId Int
  item   Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type   IdentifierType
  value  String         @unique

  @@index([itemId])
}

// ─────────────────────────────────────────────
// Suppliers, batches, walk-in purchases (#5, #12, #14, #15, #16)
// ─────────────────────────────────────────────

model Supplier {
  id       Int               @id @default(autoincrement())
  name     String
  country  String? // "UAE", "Hong Kong"
  phone    String?
  note     String?
  batches  Batch[]
  payments SupplierPayment[]
}

model Batch {
  id              Int             @id @default(autoincrement())
  supplierId      Int
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  investorId      Int // owner of every item in this batch
  investor        Investor        @relation(fields: [investorId], references: [id])
  arrivalDate     DateTime
  extraCostTotal  Decimal         @default(0) @db.Decimal(12, 2) // shipping, customs...
  costSplitMethod CostSplitMethod @default(NONE)
  note            String?
  items           Item[]
}

// Balance owed to a supplier = sum(item purchase prices in their batches) − sum(amount)
model SupplierPayment {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2) // amount that reached the supplier
  fee        Decimal  @default(0) @db.Decimal(12, 2) // transfer fee paid on top
  date       DateTime @default(now())
  note       String?
}

model WalkInSeller {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  createdAt DateTime @default(now())
  items     Item[] // devices bought from this person

  @@index([phone])
}

// ─────────────────────────────────────────────
// Transfers between locations (#1)
// ─────────────────────────────────────────────

model Transfer {
  id             Int            @id @default(autoincrement())
  fromLocationId Int
  toLocationId   Int
  userId         Int
  date           DateTime       @default(now())
  note           String?
  items          TransferItem[]
}

model TransferItem {
  transferId Int
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id])

  @@id([transferId, itemId])
}

// ─────────────────────────────────────────────
// Customers and sales (#17–#22)
// ─────────────────────────────────────────────

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  note      String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id         Int        @id @default(autoincrement())
  customerId Int? // required for debt sales (checked in code)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  locationId Int
  sellerId   Int // User who made the sale
  status     SaleStatus @default(PAID)
  total      Decimal    @db.Decimal(12, 2) // after discount
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime? // for debt sales
  createdAt  DateTime   @default(now())

  items    SaleItem[]
  payments SalePayment[]
  returns  Return[]

  @@index([status])
  @@index([createdAt])
}

// One line of a sale: a device (itemId) OR accessories (productModelId + quantity)
model SaleItem {
  id             Int           @id @default(autoincrement())
  saleId         Int
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId         Int?
  item           Item?         @relation(fields: [itemId], references: [id])
  productModelId Int?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id])
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(12, 2)

  // Snapshots taken at the moment of sale, so later changes don't rewrite history
  unitCost      Decimal   @db.Decimal(12, 2) // purchasePrice + extraCost
  investorId    Int?
  shareType     ShareType @default(NONE)
  shareValue    Decimal   @default(0) @db.Decimal(12, 2)
  warrantyUntil DateTime? // optional warranty (#19)

  @@index([itemId])
}

// Debt sales can be paid in parts
model SalePayment {
  id         Int           @id @default(autoincrement())
  saleId     Int
  sale       Sale          @relation(fields: [saleId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  receivedBy Int // User id
  date       DateTime      @default(now())
}

model Return {
  id           Int          @id @default(autoincrement())
  saleId       Int
  sale         Sale         @relation(fields: [saleId], references: [id])
  saleItemId   Int
  refundAmount Decimal      @db.Decimal(12, 2)
  result       ReturnResult
  reason       String?
  userId       Int
  date         DateTime     @default(now())
}

// ─────────────────────────────────────────────
// Consignment to partner shops (#23)
// ─────────────────────────────────────────────

model Partner {
  id             Int              @id @default(autoincrement())
  name           String
  phone          String
  marketLocation String?
  note           String?
  consignments   Consignment[]
  payments       PartnerPayment[]
}

// One handover of items to a partner
model Consignment {
  id         Int               @id @default(autoincrement())
  partnerId  Int
  partner    Partner           @relation(fields: [partnerId], references: [id])
  handedById Int // User id
  date       DateTime          @default(now())
  dueDate    DateTime? // null = no time limit; can be changed later
  note       String?
  items      ConsignmentItem[]
}

model ConsignmentItem {
  id            Int                   @id @default(autoincrement())
  consignmentId Int
  consignment   Consignment           @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  itemId        Int
  item          Item                  @relation(fields: [itemId], references: [id])
  minPrice      Decimal               @db.Decimal(12, 2) // what the partner owes us; editable while AT_PARTNER
  status        ConsignmentItemStatus @default(AT_PARTNER)
  soldAt        DateTime? // when the partner called to report the sale
  returnedAt    DateTime?

  @@index([status])
}

// Partner debt = sum(minPrice of SOLD_UNPAID + SOLD_PAID items) − sum(amount)
model PartnerPayment {
  id         Int           @id @default(autoincrement())
  partnerId  Int
  partner    Partner       @relation(fields: [partnerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  receivedBy Int // User id
  date       DateTime      @default(now())
}

// ─────────────────────────────────────────────
// Stock count, expenses, settings (#6, #24, #29)
// ─────────────────────────────────────────────

model StockCount {
  id         Int              @id @default(autoincrement())
  locationId Int
  userId     Int
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  scans      StockCountScan[]
}

// Missing items = items in this location NOT scanned; unknown = scans with no itemId
model StockCountScan {
  id           Int        @id @default(autoincrement())
  stockCountId Int
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  scannedCode  String
  itemId       Int? // null = code not found in the system
  scannedAt    DateTime   @default(now())

  @@unique([stockCountId, scannedCode])
}

model LedgerEntry {
  id       Int        @id @default(autoincrement())
  type     LedgerType
  category String // "Rent", "Salary", "Delivery" ...
  amount   Decimal    @db.Decimal(12, 2)
  date     DateTime   @default(now())
  note     String?
  userId   Int
}

// Key-value settings: Telegram backup chat id, notification chat id, etc.
model Setting {
  key   String @id
  value Json
}
