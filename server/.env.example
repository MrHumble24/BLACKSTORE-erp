# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/blackstore
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=360
PORT=3000
NODE_ENV=development

# Seed only (prisma db seed); not needed by the running server
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=

# Super admin (F12, seed only). Separate login from the owner's Admin account.
# Leave SUPER_ADMIN_PASSWORD empty to skip creating the super-admin user.
SUPER_ADMIN_PHONE=+998900000001
SUPER_ADMIN_PASSWORD=

# App Store review demo user (F35, seed only). Staff-role login for Apple's reviewer.
# Leave DEMO_PASSWORD empty to skip creating the demo user.
DEMO_PHONE=+998900000002
DEMO_PASSWORD=

# Backups (F07). BACKUP_DIR defaults to ./backups; BACKUP_PASSPHRASE is required in production.
BACKUP_DIR=./backups
# A folder on SEPARATE storage (network mount or cloud-synced); leave empty to skip the second copy.
BACKUP_SECOND_DIR=
# openssl passphrase for the encrypted dumps. Keep it safe; without it a backup cannot be restored.
BACKUP_PASSPHRASE=
# Off-site copy to Telegram (optional). Both must be set, or the send is skipped with a warning.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=

# Low-stock alerts chat (F11); empty = Telegram alerts off.
TELEGRAM_ALERT_CHAT_ID=

# Telegram device Watcher (F34), all optional. Base URL of the Watcher API, e.g. http://localhost:3100/api
WATCHER_URL=
# x-api-key the ERP sends to the Watcher (min 32 chars).
WATCHER_API_KEY=
# HMAC secret the Watcher signs match webhooks with (min 32 chars); empty = webhook rejects all.
WATCHER_WEBHOOK_SECRET=
# Minutes the Watcher may stay unreachable before the owner gets a Telegram alert; 0 = off.
WATCHER_DOWN_ALERT_MIN=10
