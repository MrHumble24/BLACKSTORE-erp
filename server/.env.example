# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/blackstore
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=30
PORT=3000
NODE_ENV=development

# Seed only (prisma db seed); not needed by the running server
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=
