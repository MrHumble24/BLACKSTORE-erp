// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LocationType {
  WAREHOUSE
  SHOP
}

enum ItemStatus {
  IN_STOCK
  AT_PARTNER
  DEBT // sold, money not fully collected
  SOLD // fully paid
  RETURNED
  DEFECTIVE
}

enum ItemCondition {
  NEW
  USED
  REFURBISHED
}

enum IdentifierType {
  IMEI
  SERIAL
  SYSTEM_CODE // our own printed label
}

enum ShareType {
  NONE // investor gets all profit
  PERCENT // investor gets shareValue % of profit
  FIXED_PER_ITEM // business keeps shareValue per item, investor gets the rest
}

enum CostSplitMethod {
  NONE // extra costs not added to items (default)
  EQUAL
  BY_PRICE
}

enum PaymentMethod {
  CASH
  CARD
}

enum SaleStatus {
  DEBT // not fully paid
  PAID
  RETURNED
}

enum ConsignmentItemStatus {
  AT_PARTNER
  SOLD // paid or not: see the linked sale's status
  RETURNED
}

// Who bears a supplier payment's transfer fee (F25).
enum FeePayer {
  BUSINESS
  INVESTOR
}

enum InvestorTxType {
  DEPOSIT // money put in
  PAYOUT // money paid back
}

enum LedgerType {
  INCOME // Prixod
  EXPENSE // Rasxod
}

// Admin decision on an EXPENSE (F27): only CONFIRMED counts against profit (BR-5) and the drawer (F13).
enum ExpenseStatus {
  PENDING // waiting for the Admin
  CONFIRMED // subtracted from net profit and expected cash
  EXCLUDED // recorded but never subtracted
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
}

enum ReturnResult {
  BACK_TO_STOCK
  DEFECTIVE
}

// Daily close / reconciliation (F13)
enum DayStatus {
  OPEN
  CLOSED
}

enum FlagRefType {
  SALE
  PAYMENT
  RETURN
  EXPENSE
  INCOME
}

enum TelegramLinkKind {
  CUSTOMER
  INVESTOR
}

// ─────────────────────────────────────────────
// Users and permissions (#26, #27)
// ─────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // "Admin", "Staff", later "Investor"
  permissions String[] // e.g. ["sell", "transfer_stock", "view_profit"]
  users       User[]
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String    @unique
  passwordHash String
  language     String    @default("uz") // "uz" | "ru"
  isActive     Boolean   @default(true)
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  investorId   Int?      @unique // set only for investor logins (Phase 2)
  investor     Investor? @relation(fields: [investorId], references: [id])
  createdAt    DateTime  @default(now())

  auditLogs      AuditLog[]
  transfers      Transfer[]
  sales          Sale[]
  salePayments   SalePayment[]
  returns        Return[]
  consignments   Consignment[]
  stockCounts    StockCount[]
  ledgerEntries  LedgerEntry[]
  businessDays   BusinessDay[] // days this user closed
  walkInPayouts  PurchaseLine[] @relation("PurchaseLinePaidBy") // walk-in payouts this user confirmed (F32)
  confirmedSales Sale[]         @relation("SaleConfirmedBy") // sales this user confirmed at the close (F33)

  issuedTelegramTokens    TelegramLinkToken[] // invite links this user handed out (F24)
  telegramLinkedCustomers Customer[]          @relation("CustomerTelegramLinkedBy")
  telegramLinkedInvestors Investor[]          @relation("InvestorTelegramLinkedBy")

  createdWatches     Watch[] @relation("WatchCreator") // F34
  matchStatusChanges Match[] @relation("MatchStatusChanger") // F34
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String // "create" | "update" | "delete" | "mark_sold" ...
  entity    String // "Item", "Sale", "ConsignmentItem" ...
  entityId  Int
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Locations and investors (#1, #9, #10)
// ─────────────────────────────────────────────

model Location {
  id       Int          @id @default(autoincrement())
  name     String       @unique // "Sklad", "Dokon"
  type     LocationType
  isActive Boolean      @default(true) // false = hidden from pick-lists, kept for history
  items    Item[]

  accessoryStock AccessoryStock[]
  transfersOut   Transfer[]       @relation("TransferFrom")
  transfersIn    Transfer[]       @relation("TransferTo")
  sales          Sale[]
  stockCounts    StockCount[]
  batches        Batch[]
}

model Investor {
  id         Int       @id @default(autoincrement())
  name       String // "Own", "Sardor", "Roshan"
  code       String    @unique // "OWN", "S", "R"
  isOwn      Boolean?  @unique // true = the business itself; null for investors, so only one row can be true
  shareType  ShareType @default(NONE)
  shareValue Decimal   @default(0) @db.Decimal(12, 2)
  isActive   Boolean   @default(true) // false = hidden from pick-lists; the OWN investor can never be deactivated

  telegramChatId     String?   @unique // linked via /start deep link (F16); null until they opt in
  telegramLinkedAt   DateTime?
  telegramLinkedById Int? // issuer of the token that was consumed (F24)
  telegramLinkedBy   User?     @relation("InvestorTelegramLinkedBy", fields: [telegramLinkedById], references: [id])

  items            Item[]
  batches          Batch[]
  transactions     InvestorTransaction[]
  saleItems        SaleItem[]
  user             User?
  supplierPayments SupplierPayment[] // money sent abroad on this investor's behalf (F25)

  // The same person's supplier record (F26): goods and money sent go through it. Never set on OWN.
  supplierId Int?      @unique
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
}

model InvestorTransaction {
  id         Int            @id @default(autoincrement())
  investorId Int
  investor   Investor       @relation(fields: [investorId], references: [id])
  type       InvestorTxType
  amount     Decimal        @db.Decimal(12, 2)
  date       DateTime       @default(now())
  note       String?
}

// ─────────────────────────────────────────────
// Catalog (#2, #4, #7)
// ─────────────────────────────────────────────

model Category {
  id           Int                 @id @default(autoincrement())
  name         String              @unique // "iPhone", "MacBook", "Accessory"
  isSerialized Boolean             @default(true) // false = counted by quantity
  isActive     Boolean             @default(true) // false = hidden from pick-lists, kept for history
  attributes   CategoryAttribute[]
  models       ProductModel[]
}

// Defines the dynamic fields for a category, e.g. MacBook → "processor", "ram"
model CategoryAttribute {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   Category      @relation(fields: [categoryId], references: [id])
  key        String // "processor"
  label      String // "Processor"
  type       AttributeType @default(TEXT)
  options    String[] // for SELECT, e.g. ["M2", "M4", "M5"]
  required   Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@unique([categoryId, key])
}

model ProductModel {
  id                Int      @id @default(autoincrement())
  categoryId        Int
  category          Category @relation(fields: [categoryId], references: [id])
  name              String // "iPhone 15 Pro", "MacBook Air 13 M4", "USB-C charger"
  lowStockThreshold Int? // alert when stock drops below this (#7)
  isActive          Boolean  @default(true) // false = hidden from pick-lists, kept for history

  items               Item[]
  stock               AccessoryStock[]
  saleItems           SaleItem[]
  purchaseLines       PurchaseLine[]
  transferAccessories TransferAccessory[]
  watches             Watch[] // F34: Watcher watches linked to this model

  @@unique([categoryId, name])
}

// Quantity-based stock for non-serialized products (#4). Always owned by the business.
model AccessoryStock {
  id             Int          @id @default(autoincrement())
  productModelId Int
  productModel   ProductModel @relation(fields: [productModelId], references: [id])
  locationId     Int
  location       Location     @relation(fields: [locationId], references: [id])
  quantity       Int          @default(0)
  avgCost        Decimal      @default(0) @db.Decimal(12, 2) // updated from PurchaseLines; copied to SaleItem.unitCost

  @@unique([productModelId, locationId])
}

// ─────────────────────────────────────────────
// Items — one row per physical device (#1, #3, #5, #11, #13, #21)
// ─────────────────────────────────────────────

model Item {
  id             Int           @id @default(autoincrement())
  productModelId Int
  productModel   ProductModel  @relation(fields: [productModelId], references: [id])
  investorId     Int
  investor       Investor      @relation(fields: [investorId], references: [id])
  locationId     Int
  location       Location      @relation(fields: [locationId], references: [id])
  status         ItemStatus    @default(IN_STOCK)
  condition      ItemCondition @default(NEW)
  attributes     Json // values for CategoryAttribute keys, e.g. {"ram": "16GB"}

  // copy of the latest PurchaseLine, so a scan shows the cost without a join
  purchasePrice Decimal  @db.Decimal(12, 2)
  extraCost     Decimal  @default(0) @db.Decimal(12, 2) // share of batch extra costs (#16)
  salePrice     Decimal? @db.Decimal(12, 2) // planned selling price
  minSalePrice  Decimal? @db.Decimal(12, 2) // staff can't sell below this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifiers      ItemIdentifier[]
  purchaseLines    PurchaseLine[] // every time we bought it; more than one if bought back
  transferItems    TransferItem[]
  saleItems        SaleItem[]
  consignmentItems ConsignmentItem[]
  stockCountScans  StockCountScan[]

  @@index([status])
  @@index([investorId])
  @@index([locationId])
}

// IMEI 1, IMEI 2, serial and system code — each value unique across ALL items
model ItemIdentifier {
  id     Int            @id @default(autoincrement())
  itemId Int
  item   Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type   IdentifierType
  value  String         @unique

  @@index([itemId])
}

// ─────────────────────────────────────────────
// Suppliers, batches, walk-in purchases (#5, #12, #14, #15, #16)
// ─────────────────────────────────────────────

model Supplier {
  id       Int               @id @default(autoincrement())
  name     String            @unique // one supplier record per name (409 on duplicate)
  country  String? // "UAE", "Hong Kong"
  phone    String?
  note     String?
  isActive Boolean           @default(true) // false = hidden from pick-lists, kept for history
  batches  Batch[]
  payments SupplierPayment[]
  investor Investor? // set when this supplier is also an investor (F26)
}

model Batch {
  id              Int             @id @default(autoincrement())
  supplierId      Int
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  investorId      Int // owner of every device in this batch (accessories are always the business's)
  investor        Investor        @relation(fields: [investorId], references: [id])
  locationId      Int // where the batch's items and accessories land (FR-8)
  location        Location        @relation(fields: [locationId], references: [id])
  arrivalDate     DateTime
  extraCostTotal  Decimal         @default(0) @db.Decimal(12, 2) // shipping, customs...
  costSplitMethod CostSplitMethod @default(NONE)
  note            String?
  lines           PurchaseLine[]
}

// One purchase: a device (itemId) OR accessories (productModelId + quantity),
// from a supplier batch OR a walk-in seller. Never overwritten.
model PurchaseLine {
  id             Int           @id @default(autoincrement())
  itemId         Int?
  item           Item?         @relation(fields: [itemId], references: [id])
  productModelId Int?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id])
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(12, 2) // what we paid
  extraCost      Decimal       @default(0) @db.Decimal(12, 2) // per unit, from the batch split (#16)

  batchId        Int?
  batch          Batch?        @relation(fields: [batchId], references: [id])
  walkInSellerId Int?
  walkInSeller   WalkInSeller? @relation(fields: [walkInSellerId], references: [id])

  // Walk-in lines only: when the Admin confirmed the seller was paid from the drawer (F32).
  // null = payout not confirmed yet (not subtracted from expected cash).
  paidAt   DateTime?
  paidById Int?
  paidBy   User?     @relation("PurchaseLinePaidBy", fields: [paidById], references: [id])

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([batchId])
}

// Balance owed to a supplier = sum(unitPrice × quantity of lines in their batches) − sum(amount)
model SupplierPayment {
  id         Int       @id @default(autoincrement())
  supplierId Int
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  amount     Decimal   @db.Decimal(12, 2) // amount that reached the supplier
  fee        Decimal   @default(0) @db.Decimal(12, 2) // transfer fee paid on top
  date       DateTime  @default(now())
  note       String?
  investorId Int? // whose money was sent (F25); null = the business's own money
  investor   Investor? @relation(fields: [investorId], references: [id])
  feePaidBy  FeePayer  @default(BUSINESS) // who bears `fee`; INVESTOR only allowed when investorId is set or the supplier is linked (F26)

  @@index([investorId])
}

model WalkInSeller {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String
  createdAt DateTime       @default(now())
  purchases PurchaseLine[] // what we bought from this person

  @@index([phone])
}

// ─────────────────────────────────────────────
// Transfers between locations (#1)
// ─────────────────────────────────────────────

model Transfer {
  id             Int                 @id @default(autoincrement())
  fromLocationId Int
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   Int
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  userId         Int
  user           User                @relation(fields: [userId], references: [id])
  date           DateTime            @default(now())
  note           String?
  items          TransferItem[]
  accessories    TransferAccessory[]
}

model TransferItem {
  transferId Int
  transfer   Transfer @relation(fields: [transferId], references: [id])
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id])

  @@id([transferId, itemId])
}

// Accessory quantities moved in a transfer (devices move via TransferItem).
model TransferAccessory {
  transferId     Int
  transfer       Transfer     @relation(fields: [transferId], references: [id])
  productModelId Int
  productModel   ProductModel @relation(fields: [productModelId], references: [id])
  quantity       Int

  @@id([transferId, productModelId])
}

// ─────────────────────────────────────────────
// Customers and sales (#17–#22)
// ─────────────────────────────────────────────

model Customer {
  id                 Int       @id @default(autoincrement())
  name               String
  phone              String    @unique
  note               String?
  telegramChatId     String?   @unique // linked via /start deep link (F16); null until they opt in
  telegramLinkedAt   DateTime?
  telegramLinkedById Int? // issuer of the token that was consumed (F24)
  telegramLinkedBy   User?     @relation("CustomerTelegramLinkedBy", fields: [telegramLinkedById], references: [id])
  createdAt          DateTime  @default(now())
  sales              Sale[]
}

model Sale {
  id         Int        @id @default(autoincrement())
  customerId Int? // required for debt sales, unless partnerId is set (checked in code)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  partnerId  Int? // set when a partner shop reported this sale (#23)
  partner    Partner?   @relation(fields: [partnerId], references: [id])
  locationId Int
  location   Location   @relation(fields: [locationId], references: [id])
  sellerId   Int // User who made the sale
  seller     User       @relation(fields: [sellerId], references: [id])
  status     SaleStatus @default(PAID)
  total      Decimal    @db.Decimal(12, 2) // after discount
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime? // for debt sales
  createdAt  DateTime   @default(now())

  // Drawer gate only (F33): the sale's money counts in the drawer from confirmedAt on; null = waiting.
  // Status, debt (BR-8) and profit (BR-6) never depend on it.
  confirmedAt   DateTime?
  confirmedById Int?
  confirmedBy   User?     @relation("SaleConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  items    SaleItem[]
  payments SalePayment[]
  returns  Return[]

  @@index([status])
  @@index([createdAt])
  @@index([partnerId]) // partner debt aggregation and the /sales?partnerId filter (F07)
  @@index([confirmedAt])
}

// One line of a sale: a device (itemId) OR accessories (productModelId + quantity)
model SaleItem {
  id             Int           @id @default(autoincrement())
  saleId         Int
  sale           Sale          @relation(fields: [saleId], references: [id])
  itemId         Int?
  item           Item?         @relation(fields: [itemId], references: [id])
  productModelId Int?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id])
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(12, 2)

  // Snapshots taken at the moment of sale, so later changes don't rewrite history
  unitCost      Decimal   @db.Decimal(12, 2) // purchasePrice + extraCost
  investorId    Int?
  investor      Investor? @relation(fields: [investorId], references: [id])
  shareType     ShareType @default(NONE)
  shareValue    Decimal   @default(0) @db.Decimal(12, 2)
  warrantyUntil DateTime? // optional warranty (#19)

  returns         Return[]
  consignmentItem ConsignmentItem?

  @@index([itemId])
}

// Debt sales can be paid in parts. A partner's lump-sum payment is split over
// their unpaid sales, oldest first.
model SalePayment {
  id         Int           @id @default(autoincrement())
  saleId     Int
  sale       Sale          @relation(fields: [saleId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  receivedBy Int // User id
  receiver   User          @relation(fields: [receivedBy], references: [id])
  date       DateTime      @default(now()) // editable business/display date
  createdAt  DateTime      @default(now()) // server-set, immutable; reconciliation window keys off this (F13)
}

model Return {
  id           Int          @id @default(autoincrement())
  saleId       Int
  sale         Sale         @relation(fields: [saleId], references: [id])
  saleItemId   Int
  saleItem     SaleItem     @relation(fields: [saleItemId], references: [id])
  quantity     Int          @default(1) // accessories can be returned partly
  refundAmount Decimal      @db.Decimal(12, 2)
  cashRefund   Decimal      @default(0) @db.Decimal(12, 2) // server-computed cash handed back (vs debt cancelled); F13 drawer math
  result       ReturnResult
  reason       String?
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  date         DateTime     @default(now()) // editable business/display date
  createdAt    DateTime     @default(now()) // server-set, immutable; reconciliation window keys off this (F13)
}

// ─────────────────────────────────────────────
// Consignment to partner shops (#23)
// ─────────────────────────────────────────────

model Partner {
  id             Int           @id @default(autoincrement())
  name           String
  phone          String? // optional since F29
  marketLocation String?
  note           String?
  consignments   Consignment[]
  sales          Sale[] // partner debt = sum(sale totals) − sum(sale payments), same as customers
}

// One handover of items to a partner
model Consignment {
  id         Int               @id @default(autoincrement())
  partnerId  Int
  partner    Partner           @relation(fields: [partnerId], references: [id])
  handedById Int // User id
  handedBy   User              @relation(fields: [handedById], references: [id])
  date       DateTime          @default(now())
  dueDate    DateTime? // null = no time limit; can be changed later
  note       String?
  items      ConsignmentItem[]

  @@index([partnerId])
}

model ConsignmentItem {
  id            Int                   @id @default(autoincrement())
  consignmentId Int
  consignment   Consignment           @relation(fields: [consignmentId], references: [id])
  itemId        Int
  item          Item                  @relation(fields: [itemId], references: [id])
  minPrice      Decimal               @db.Decimal(12, 2) // what the partner owes us; editable while AT_PARTNER
  status        ConsignmentItemStatus @default(AT_PARTNER)
  soldAt        DateTime? // when the partner called to report the sale
  saleItemId    Int?                  @unique // the sale line created at that moment, unitPrice = minPrice
  saleItem      SaleItem?             @relation(fields: [saleItemId], references: [id])
  returnedAt    DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────
// Stock count, expenses, settings (#6, #24, #29)
// ─────────────────────────────────────────────

model StockCount {
  id         Int              @id @default(autoincrement())
  locationId Int
  location   Location         @relation(fields: [locationId], references: [id])
  userId     Int
  user       User             @relation(fields: [userId], references: [id])
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  scans      StockCountScan[]

  @@index([locationId, finishedAt])
}

// Missing items = items in this location NOT scanned; unknown = scans with no itemId
model StockCountScan {
  id           Int        @id @default(autoincrement())
  stockCountId Int
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  scannedCode  String
  itemId       Int? // null = code not found in the system
  item         Item?      @relation(fields: [itemId], references: [id])
  scannedAt    DateTime   @default(now())

  @@unique([stockCountId, scannedCode])
}

model LedgerEntry {
  id             Int           @id @default(autoincrement())
  type           LedgerType
  category       String // "Rent", "Salary", "Delivery" ...
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @default(now()) // editable business/display date
  createdAt      DateTime      @default(now()) // server-set, immutable; reconciliation window keys off this (F13)
  inCash         Boolean       @default(true) // true = cash drawer; false = bank/card (F13 drawer math)
  note           String?
  countsInProfit Boolean       @default(false) // Admin confirms this INCOME adds to net profit (BR-5); always false for EXPENSE (expense profit impact is `status`)
  status         ExpenseStatus @default(PENDING) // EXPENSE: Admin decision (F27); INCOME: always CONFIRMED, ignored
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
}

// Key-value settings: Telegram backup chat id, notification chat id, etc.
model Setting {
  key   String @id
  value Json
}

// ─────────────────────────────────────────────
// Daily close / reconciliation (F13, anti-fraud)
// ─────────────────────────────────────────────

// One trading day. Exactly one row is OPEN (enforced by a partial unique index in
// the migration). The expected/counted/variance values are an immutable close-time
// snapshot — frozen at close, never re-read as a live balance.
model BusinessDay {
  id           Int       @id @default(autoincrement())
  openedAt     DateTime  @default(now())
  closedAt     DateTime? // set at close; window is half-open [openedAt, closedAt)
  status       DayStatus @default(OPEN)
  expectedCash Decimal?  @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  cashVariance Decimal?  @db.Decimal(12, 2)
  expectedCard Decimal?  @db.Decimal(12, 2)
  countedCard  Decimal?  @db.Decimal(12, 2)
  cardVariance Decimal?  @db.Decimal(12, 2)
  note         String?
  closedById   Int?
  closedBy     User?     @relation(fields: [closedById], references: [id])

  flags DayCloseFlag[]

  @@index([status])
}

// A suspicious record the owner flagged while closing a day (FR-30 audited).
model DayCloseFlag {
  id            Int         @id @default(autoincrement())
  businessDayId Int
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])
  refType       FlagRefType
  refId         Int
  reason        String
  resolved      Boolean     @default(false)
  resolvedById  Int?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([businessDayId])
}

// One-time, 7-day-expiring deep-link token (F16). A customer/investor taps
// https://t.me/<bot>?start=<token>; /start consumes it and links their chat. High-entropy random
// token, so no signing secret is needed — the row itself gives one-time + expiry.
model TelegramLinkToken {
  id         Int              @id @default(autoincrement())
  token      String           @unique
  kind       TelegramLinkKind
  refId      Int // Customer.id or Investor.id, per kind
  expiresAt  DateTime
  usedAt     DateTime? // set when consumed; null = still usable
  createdAt  DateTime         @default(now())
  issuedById Int? // staff user who minted the link (F24); null for tokens from before F24
  issuedBy   User?            @relation(fields: [issuedById], references: [id])

  @@index([kind, refId]) // reuse lookup: newest live token for a (kind, refId)
}

/// Chats that have ever sent the bot an update (F21). Written by the telegram-bot module (owner),
/// read and cleared by integrations. Not a customer/investor link (that is TelegramLinkToken).
// ponytail: table grows by one row per Telegram user who ever messages the bot; only the newest 50
// are listed. Add pruning by lastSeenAt if a shop's customer /start traffic pushes its groups off the list.
model TelegramKnownChat {
  chatId     String   @id // Telegram chat id as a string (Int64; groups are negative)
  title      String // group/channel title, or the person's name/username
  type       String // private | group | supergroup | channel
  lastSeenAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Watcher integration (F34): devices the owner wants to buy and the Telegram offers found
// ─────────────────────────────────────────────

// A device the owner is looking for: model name plus aliases the Watcher matches against.
// currency is a label only (BR-11 exception, answers B5): no conversion, no sums.
model Watch {
  id             Int           @id @default(autoincrement())
  name           String
  aliases        String[]
  productModelId Int?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id], onDelete: SetNull) // so the super-admin hard delete of a product model still works
  maxPrice       Decimal?      @db.Decimal(12, 2)
  currency       String        @default("USD") // "USD" | "UZS"
  isActive       Boolean       @default(true) // BR-12: switched off, never deleted
  syncedAt       DateTime? // last successful push to the Watcher; stale when < updatedAt
  createdById    Int
  createdBy      User          @relation("WatchCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  matches        Match[]

  @@index([isActive])
  @@index([productModelId])
}

enum MatchStatus {
  NEW
  SEEN
  CONTACTED
  BOUGHT
  IGNORED
}

// One seller offer the Watcher found for a watch; created only by the webhook.
model Match {
  id                Int         @id @default(autoincrement())
  externalId        String      @unique // Watcher matchId; makes webhook retries idempotent
  watchId           Int
  watch             Watch       @relation(fields: [watchId], references: [id])
  status            MatchStatus @default(NEW)
  device            String
  price             Decimal?    @db.Decimal(12, 2)
  currency          String? // label only (BR-11 exception)
  condition         String?
  confidence        Decimal     @db.Decimal(4, 3)
  sellerName        String?
  sellerTelegramId  String? // stored, never returned to the client
  sellerUsername    String?
  messageText       String
  messageLink       String? // null for basic groups (no message links)
  groupTitle        String
  parentText        String?
  messageAt         DateTime
  receivedAt        DateTime    @default(now())
  statusChangedAt   DateTime?
  statusChangedById Int?
  statusChangedBy   User?       @relation("MatchStatusChanger", fields: [statusChangedById], references: [id])
  note              String?

  @@index([watchId])
  @@index([status, receivedAt])
}
